   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Night Snap D - Neon Street</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default"/>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
