    <rdf:Alt>
     <rdf:li xml:lang="x-default">Night Street Snap</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">For bright neon streets: protects signs from blowing out, keeps faces bright, mutes neon, same blue matte look as C. Masks for people/background must be added by hand.</rdf:li>
    </rdf:Alt>
   </crs:Description>
