   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Curves measured from the original vs. the edited example: lifted blacks, blue shadows, soft grain. Masks for people/background must be added by hand.</rdf:li>
    </rdf:Alt>
